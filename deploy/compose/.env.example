# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
SESSION_SECRET=replace-with-output-of-make-env
API_KEY_PEPPER=replace-with-output-of-make-env
LOCAL_MASTER_KEY=replace-with-output-of-make-env
CF_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional overrides
# CF_LOG_LEVEL=INFO
# CF_REDIS_URL=               (empty: run the whole stack without Redis)
# CF_WEB_PORT=4310
# CF_API_PORT=4330
# CF_MOCK_LLM_PORT=4350
# CF_PG_PORT=4342
# CF_REDIS_PORT=4379
# CF_FLOCI_PORT=4366
